{
  "uid": "de13-portfolio",
  "title": "Portfolio Demo Overview",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "15s",
  "panels": [
    { "id": 1, "type": "timeseries", "title": "HTTP requests per second", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "targets": [{ "expr": "sum(rate(http_requests_total[5m])) by (route)", "refId": "A" }] },
    { "id": 2, "type": "timeseries", "title": "Container CPU", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{image!=\"\"}[5m])) by (name)", "refId": "A" }] },
    { "id": 3, "type": "timeseries", "title": "Container memory", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "targets": [{ "expr": "sum(container_memory_working_set_bytes{image!=\"\"}) by (name)", "refId": "A" }] },
    { "id": 4, "type": "timeseries", "title": "Backend uptime", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "targets": [{ "expr": "process_uptime_seconds", "refId": "A" }] },
    { "id": 5, "type": "stat", "title": "MySQL availability", "gridPos": { "h": 5, "w": 6, "x": 0, "y": 16 }, "targets": [{ "expr": "mysql_up", "refId": "A" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" } },
    { "id": 6, "type": "timeseries", "title": "MySQL active connections", "gridPos": { "h": 8, "w": 18, "x": 6, "y": 16 }, "targets": [{ "expr": "mysql_global_status_threads_connected", "refId": "A" }] }
  ]
}
